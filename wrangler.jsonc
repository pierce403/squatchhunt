 "env":{"staging":{"name":"squatch-hunt-staging","preview_urls":false,"routes":[],"vars":{"AUTH_DOMAIN":"squatch-hunt-staging.bcrt43.workers.dev"}}},
 "routes":[{"pattern":"squatchhunt.com/*","zone_name":"squatchhunt.com"}]
}
